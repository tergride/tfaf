{
  "name": "tfaf-launcher",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "TFAF desktop client for FAF servers: custom games, maps and mods",
  "author": "Tergride",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/tergride/tfaf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tergride/tfaf.git"
  },
  "bugs": {
    "url": "https://github.com/tergride/tfaf/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run fetch:native && npm run build && electron-builder --config electron-builder.config.mjs --win --publish never",
    "fetch:native": "node scripts/fetch-native.mjs",
    "art": "electron scripts/resize-art.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lucide/vue": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.5",
    "@tanstack/vue-table": "^8.21.3",
    "@types/node": "^24.0.0",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vee-validate": "^4.15.1",
    "vite": "^7.3.6",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true
  }
}
